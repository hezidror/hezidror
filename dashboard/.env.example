# העתק קובץ זה ל-.env ומלא את הערכים שלך. אל תעלה .env לגיטהאב!

# סיסמת הכניסה לדשבורד - רק מי שיודע אותה יכול להיכנס
DASHBOARD_PASSWORD=change-me

# מפתח סודי לניהול session (מחרוזת אקראית ארוכה, אפשר להשתמש ב: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-too

# מזהה יומן גוגל (בדרך כלל כתובת המייל של היומן, למשל hairstylinghd@gmail.com)
GOOGLE_CALENDAR_ID=hairstylinghd@gmail.com

# נתיב לקובץ Service Account JSON שהורדת מ-Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# מתאריך זה ואילך ייקראו אירועים מהיומן (פורמט YYYY-MM-DD)
HISTORY_START_DATE=2024-01-01

# אזור זמן
TIMEZONE=Asia/Jerusalem
